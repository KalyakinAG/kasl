Функция ПолучитьПоляВводаПоСтроке(МетаданныеОбъекта) Экспорт
	
	ПоляПоиска = Новый Массив;
	Для каждого Поле из МетаданныеОбъекта.ВводПоСтроке Цикл
		ПоляПоиска.Добавить(Поле.Имя);
	КонецЦикла;
	
	Возврат ПоляПоиска;
	
КонецФункции

Функция ПолучитьПредставление(Шаблон, Данные, Поля) Экспорт
	Если ПустаяСтрока(Шаблон) Тогда
		МассивСтрокПредставления = Новый Массив;
		Для Каждого ИмяПоля Из Поля Цикл
			МассивСтрокПредставления.Добавить(Данные[ИмяПоля]);
		КонецЦикла;
		Представление = СтрСоединить(МассивСтрокПредставления, ",");
	Иначе
		Представление = СтрЗаменить(Шаблон, "[ПредставлениеСсылки]", Данные.ПредставлениеСсылки);
		Для Каждого ИмяПоля Из Поля Цикл
			Представление = СтрЗаменить(Представление, "["+ИмяПоля+"]", СокрП(Данные[ИмяПоля]));
		КонецЦикла;
	КонецЕсли;
	Возврат Представление;
КонецФункции

Функция ПолучитьСтрокуСВыделением(Источник, Образец) Экспорт
	Если ПустаяСтрока(Образец) Тогда
		Возврат Источник;
	КонецЕсли;
	ИсточникДляПоиска		= НРег(Источник);
	//@skip-check new-font
	ШрифтВыделения			= Новый Шрифт(, , Истина);
	ЦветВыделения			= ЦветаСтиля.ЦветОсобогоТекста;
	ДлинаОбразца			= СтрДлина(Образец);
	МассивСтрок				= Новый Массив;
	ИндексПозиции			= 1;
	ДлинаИсточника			= СтрДлина(Источник);
	Пока ИндексПозиции <= ДлинаИсточника Цикл
		НайденныйИндексПозиции = СтрНайти(ИсточникДляПоиска, Образец, НаправлениеПоиска.СНачала, ИндексПозиции);
		Если НайденныйИндексПозиции = 0 Тогда
			МассивСтрок.Добавить(Сред(Источник, ИндексПозиции));
			Прервать;
		КонецЕсли;
		МассивСтрок.Добавить(Сред(Источник, ИндексПозиции, НайденныйИндексПозиции - ИндексПозиции));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Сред(Источник, НайденныйИндексПозиции, ДлинаОбразца), ШрифтВыделения, ЦветВыделения));
		ИндексПозиции = НайденныйИндексПозиции + ДлинаОбразца;
	КонецЦикла;
	Возврат Новый ФорматированнаяСтрока(МассивСтрок);
КонецФункции

// Заполняет данные выбора для автоподбора по введенной строке.
//
// Параметры:
//  ПолноеИмя           - Строка - полное имя объекта метаданных
//  ДанныеВыбора        - СписокЗначений из ФорматированнаяСтрока - заполняемый список значений с данными выбора
//  Параметры           - Структура - параметры данных выбора, содержит:
//                        * СтрокаПоиска - Строка - введенная пользователем строка для поиска
//                        * СпособПоискаСтроки - ПеречислимыеСвойстваОбъектовМетаданных - СвойстваОбъектов.СпособПоискаСтрокиПриВводеПоСтроке
//  ПоляВводаПоСтроке   - Массив из Строка - имена полей, по которым осуществляется поиск.
//                        Если не указано, используются стандартные поля из метаданных
//                      - Строка - имя единственного поля поиска
//  ШаблонПредставления - Строка - перечень полей, выводимых в качестве представления найденного значения
Процедура ЗаполнитьДанныеВыбора(ПолноеИмя, ДанныеВыбора, Параметры, Знач ПоляВводаПоСтроке = Неопределено
	, Знач ШаблонПредставления = Неопределено) Экспорт
	
	МенеджерОбъекта		= ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	МетаданныеОбъекта	= МенеджерОбъекта.ПустаяСсылка().Метаданные();

	СпособПоискаСтроки 	= Неопределено;
	Если Не Параметры.Свойство("СпособПоискаСтроки", СпособПоискаСтроки) ИЛИ СпособПоискаСтроки = Неопределено Тогда
		СпособПоискаСтроки = МетаданныеОбъекта.СпособПоискаСтрокиПриВводеПоСтроке;	
	КонецЕсли;
	
	Если ПоляВводаПоСтроке = Неопределено Тогда
		ПоляВводаПоСтроке = ПолучитьПоляВводаПоСтроке(МетаданныеОбъекта);	
	Иначе
		Если ТипЗнч(ПоляВводаПоСтроке) = Тип("Строка") Тогда
			ПоляВводаПоСтроке = РаботаСМассивом.Массив(ПоляВводаПоСтроке);
		КонецЕсли;
	КонецЕсли;
	
	СтрокаПоиска = Параметры.СтрокаПоиска;
	Условия = Новый Массив;
	
	Если ЗначениеЗаполнено(СтрокаПоиска) Тогда
	
		Если СпособПоискаСтроки = СпособПоискаСтрокиПриВводеПоСтроке.Начало Тогда
			ШаблонУсловия = "Источник.%1 ПОДОБНО """+СтрокаПоиска + "%%""";
		Иначе
			ШаблонУсловия = "Источник.%1 ПОДОБНО ""%%"+СтрокаПоиска + "%%""";
		КонецЕсли;
		
		Для Каждого Поле Из ПоляВводаПоСтроке Цикл
			Условия.Добавить(СтрШаблон(ШаблонУсловия, Поле));
		КонецЦикла;
	
	КонецЕсли;	
	
	МодельЗапроса = МодельЗапросаОбъектаДанныхВыбора(ПолноеИмя, Параметры, "Ссылка, ПометкаУдаления, " + СтрСоединить(ПоляВводаПоСтроке, ", "));
	МодельЗапроса.Первые(50).Разрешенные()
		.ПредставлениеСсылки("Источник.Ссылка", "ПредставлениеСсылки")
		.УсловныйОтбор(ЗначениеЗаполнено(Условия), СтрШаблон("(%1)", СтрСоединить(Условия, " ИЛИ ")))
	;
	
	Выборка	= МодельЗапроса.ВыполнитьЗапрос().ВыбратьРезультат();
	ДанныеВыбора = Новый СписокЗначений;
	СтрокаПоиска = НРег(СтрокаПоиска);
	Пока Выборка.Следующий() Цикл
		ЗначениеСписка	= Новый Структура;
		ЗначениеСписка.Вставить("Значение", Выборка.Ссылка);
		ЗначениеСписка.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
		ДанныеВыбора.Добавить(ЗначениеСписка, ПолучитьСтрокуСВыделением(ПолучитьПредставление(ШаблонПредставления, Выборка, ПоляВводаПоСтроке), СтрокаПоиска));
	КонецЦикла;
	
КонецПроцедуры

Функция МодельЗапросаОбъектаДанныхВыбора(ПолноеИмя, Параметры, Поля = "", ТекстЗапроса = "", ЭтоДинамическийСписок = Ложь) Экспорт

	ОбъектДанныхВыбора = ОбъектДанныхВыбораПоПолномуИмени(ПолноеИмя);
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		МодельЗапроса = РаботаСМодельюЗапроса.МодельЗапроса(ТекстЗапроса);
	Иначе
		МодельЗапроса = РаботаСМодельюЗапроса.МодельЗапроса();
		МодельЗапроса.ЗапросПакета()
			.Источник(ОбъектДанныхВыбора.ПолноеИмя, "Источник")
		;
		Если Не ЗначениеЗаполнено(Поля) Тогда
			Для каждого Реквизит Из ОбъектДанныхВыбора.МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				МодельЗапроса.Поле(Реквизит.Имя);
			КонецЦикла;
		ИначеЕсли Поля = "*" Тогда
			ДоступныеПоля = МодельЗапроса.Источник.ДоступныеПоля;
			Для Каждого Поле Из ДоступныеПоля Цикл
				МодельЗапроса.Поле(Поле.Имя);
			КонецЦикла;
		Иначе
			Для Каждого Поле Из РаботаСМассивом.Массив(Поля) Цикл
				МодельЗапроса.Поле(Поле);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Метаданные.ОпределяемыеТипы.ОбъектыДанныхВыбора.Тип.СодержитТип(ОбъектДанныхВыбора.Тип) Тогда
		ОбъектДанныхВыбора.МенеджерОбъекта.ПриСозданииМоделиЗапросаОбъектаДанныВыбора(МодельЗапроса, Параметры);
	КонецЕсли;
	
	РаботаСДаннымиВыбораПереопределяемый.ПриСозданииМоделиЗапросаОбъектаДанныВыбора(МодельЗапроса, Параметры);

	Если ЭтоДинамическийСписок Тогда
		
		МетаданныеОбъекта = ОбъектДанныхВыбора.МетаданныеОбъекта;
		Если Метаданные.Справочники.Содержит(МетаданныеОбъекта) 
			И МетаданныеОбъекта.Иерархический 
			И МетаданныеОбъекта.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов
		Тогда
			ОператорВыбрать = МодельЗапроса.ОператорВыбрать;
			Источник = МодельЗапроса.УстановитьИсточник("Источник").Источник;
			//  Шаблон "Расширение данных источника" (подсистема "Работа со схемой запроса")
			Для Каждого Соединение Из Источник.Соединения Цикл
				Если Соединение.ТипСоединения = ТипСоединенияСхемыЗапроса.Внутреннее Тогда
					ИсточникСправа = Соединение.Источник.Источник;
					Соединение.ТипСоединения = ТипСоединенияСхемыЗапроса.ЛевоеВнешнее;
					МодельЗапроса
						.Отбор(СтрШаблон("НЕ %1.%2 ЕСТЬ NULL", ИсточникСправа.Псевдоним, ИсточникСправа.ДоступныеПоля[0].Имя))
					;
				КонецЕсли;
			КонецЦикла;
			
			Если ОператорВыбрать.Отбор.Количество() > 0 Тогда
				МассивУсловияОтбора = Новый Массив;
				Для Каждого Отбор Из ОператорВыбрать.Отбор Цикл
					МассивУсловияОтбора.Добавить(Строка(Отбор));
				КонецЦикла;
				ОператорВыбрать.Отбор.Очистить();
				ОператорВыбрать.Отбор.Добавить(СтрШаблон("(%1) ИЛИ Источник.ЭтоГруппа", СтрСоединить(МассивУсловияОтбора, ") И (")));
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Отбор = Неопределено;
		Если Параметры.Свойство("Отбор", Отбор) Тогда
			Для Каждого ЭлементОтбора Из Параметры.Отбор Цикл
				МодельЗапроса.Отбор(СтрШаблон("%1 = &%1", ЭлементОтбора.Ключ));
				МодельЗапроса.Параметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
			КонецЦикла;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат МодельЗапроса;
	
КонецФункции

// Настраивает динамический список по модели данных выбора: формирует текст запроса,
// устанавливает значения параметров компоновки и сохраняет параметры запроса
// в дополнительных свойствах компоновщика настроек.
//
// Параметры:
//  Список - ДинамическийСписок - настраиваемый динамический список.
//  Параметры - Структура - параметры для построения модели запроса. Состав и назначение ключей
//            определяется моделью данных выбора основной таблицы списка.
//  Поля - Неопределено - используются все доступные поля динамического списка.
//        - Массив из Строка - имена полей, включаемых в настройку.
//
// Пример:
//  &НаСервере
//  Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
//	  РаботаСДаннымиВыбора.НастроитьДинамическийСписок(Список, Параметры);
//  КонецПроцедуры
//
Процедура НастроитьДинамическийСписок(Список, Параметры, Поля = Неопределено) Экспорт
	
	ПолноеИмя = Список.ОсновнаяТаблица;
	МодельЗапроса = МодельЗапросаОбъектаДанныхВыбора(ПолноеИмя
		, Параметры, Поля, ?(Список.ПроизвольныйЗапрос, Список.ТекстЗапроса, ""), Истина);
	ПараметрыЗапроса = МодельЗапроса.Параметры;
	Список.ТекстЗапроса	= МодельЗапроса.ТекстЗапроса();
	Список.ОсновнаяТаблица = ПолноеИмя;
	
	Для Каждого ДоступныйПараметрКомпоновки Из Список.Параметры.ДоступныеПараметры.Элементы Цикл
		
		ПараметрКомпоновки = ДоступныйПараметрКомпоновки.Параметр;
		ЗначениеПараметра = Неопределено;
		
		Если НЕ ПараметрыЗапроса.Свойство(Строка(ПараметрКомпоновки), ЗначениеПараметра) Тогда
			Продолжить;
		КонецЕсли;
		
		Список.Параметры.УстановитьЗначениеПараметра(ПараметрКомпоновки, ЗначениеПараметра);
		
	КонецЦикла;
	
	Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ТекстЗапроса", Список.ТекстЗапроса);
	Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("Параметры", ПараметрыЗапроса);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйОбъектДанныхВыбора()
	
	ОбъектМоделиЗапроса = Новый Структура;
	ОбъектМоделиЗапроса.Вставить("ПолноеИмя", "");
	ОбъектМоделиЗапроса.Вставить("МетаданныеОбъекта", Неопределено);
	ОбъектМоделиЗапроса.Вставить("Тип", Неопределено);
	ОбъектМоделиЗапроса.Вставить("МенеджерОбъекта", Неопределено);
	ОбъектМоделиЗапроса.Вставить("МетаданныеОбъекта", Неопределено);
	Возврат ОбъектМоделиЗапроса;
	
КонецФункции

Функция ОбъектДанныхВыбораПоПолномуИмени(ПолноеИмя)
	
	ОбъектДанныхВыбора = НовыйОбъектДанныхВыбора();
	МенеджерОбъекта	= ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	ПустаяСсылка = МенеджерОбъекта.ПустаяСсылка();
	ОбъектДанныхВыбора.ПолноеИмя = ПолноеИмя;
	ОбъектДанныхВыбора.Тип = ТипЗнч(ПустаяСсылка);
	ОбъектДанныхВыбора.МенеджерОбъекта = МенеджерОбъекта;
	ОбъектДанныхВыбора.МетаданныеОбъекта = ПустаяСсылка.Метаданные();
	Возврат ОбъектДанныхВыбора;

КонецФункции

#КонецОбласти
